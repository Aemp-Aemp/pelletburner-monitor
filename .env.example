# Settings for the pellet burner monitor.
# Copy this file to .env (next to docker-compose.yml), change what you need, then run:
#   docker compose up -d
# A line that starts with # is not used. Empty = the default shown.

# USB-serial adapter on the boiler's module port. Leave empty with one adapter (found by itself).
# With more than one, use its stable name (list them with: ls /dev/serial/by-id/)
#BURNER_SERIAL=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_XXXXXXXX-if00-port0

# Web page port. The page is http://<pi-address>:8787/home
#BURNER_HTTP_PORT=8787

# Names the page may be opened under, comma separated. "lan" = any private address on your home network.
# Everyone who can open the page can use its buttons and settings.
#BURNER_ALLOWED_HOSTS=lan,pelletpi.local

# 1 = the page and Home Assistant may start and stop the burner. 0 = view only.
#BURNER_REMOTE_START=1

# Days of history kept in the data folder (0 = never delete). About 35 MB a day, mostly raw-* files.
#BURNER_KEEP_DAYS=30

# The log file is rotated at this size in MB (3 old files kept).
#BURNER_LOG_MAX_MB=50

# Home Assistant over MQTT (optional). Empty BURNER_MQTT = no MQTT.
#BURNER_MQTT=homeassistant.local
#BURNER_MQTT_USER=burner
#BURNER_MQTT_PASS=the-password
# 1 = send values only, no buttons or switches in Home Assistant.
#BURNER_MQTT_READ_ONLY=0
# First part of every MQTT topic.
#BURNER_MQTT_PREFIX=burner
